// @see - https://www.electron.build/configuration/configuration
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'YourAppID',
  asar: true,
  // macOS 26 + Electron 42 + electron-builder 26.x の組み合わせでは、
  // packaged app 起動時に helper app 名と CFBundleName / 実行ファイル名の整合性が崩れると、
  // JavaScript 実行前に `Unable to find helper app` / SIGTRAP で落ちることがある。
  // https://github.com/electron-userland/electron-builder/issues/9771
  //
  // productName に `é` などの合成可能な文字を使うと NFC / NFD の違いで再現する。
  // その場合は `e + combining acute` (`\u0301`) のように分解済みの形で書き、
  // electron-builder が生成する .app / helper / CFBundleExecutable の名前と正規化を揃える。
  productName: 'YourAppName',
  directories: {
    output: 'release/${version}',
  },
  files: [
    'dist',
    'public',
    {
      from: '../web/dist',
      to: 'web/dist',
      filter: ['**/*'],
    },
  ],

  mac: {
    target: ['dmg'],
    artifactName: '${productName}-Mac-${version}-Installer.${ext}',
    icon: 'public/app.icns',
  },
  win: {
    target: [
      {
        target: 'nsis',
        arch: ['x64'],
      },
    ],
    artifactName: '${productName}-Windows-${version}-Setup.${ext}',
    icon: 'public/app.ico',
  },
  nsis: {
    installerIcon: 'public/app.ico',
    uninstallerIcon: 'public/app.ico',
    installerHeaderIcon: 'public/app.ico',
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
  },
  linux: {
    target: ['AppImage'],
    artifactName: '${productName}-Linux-${version}.${ext}',
  },
}
