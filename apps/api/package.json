{
  "name": "@your-app-name/api",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/api/*.ts",
      "import": "./src/api/*.ts"
    },
    "./main": {
      "types": "./src/main/registerIpc.ts",
      "import": "./src/main/registerIpc.ts"
    },
    "./preload": {
      "types": "./src/preload/electronApi.ts",
      "import": "./src/preload/electronApi.ts"
    },
    "./renderer": {
      "types": "./src/renderer/api.ts",
      "import": "./src/renderer/api.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/ai": "workspace:*",
    "@repo/auth": "workspace:*",
    "@repo/deep-merge": "workspace:*",
    "@repo/ipc": "workspace:*",
    "@repo/object-store": "workspace:*",
    "@repo/sqlite": "workspace:*",
    "@repo/sqlite-table-editor": "workspace:*",
    "@repo/todo": "workspace:*",
    "@tanstack/ai": "catalog:"
  },
  "devDependencies": {
    "electron": "^45.3.3"
  }
}
