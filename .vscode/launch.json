{
  // IntelliSense を使用して利用可能な属性を学べます。
  // 既存の属性の説明をホバーして表示します。
  // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Debug App",
      "configurations": [
        "Launch Vite Dev",
        "Debug Main Process",
        "Debug Renderer Process"
      ],
      "stopAll": true
    }
  ],
  "configurations": [
    {
      "name": "Launch Vite Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Debug Main Process",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9229,
      "restart": true,
      "timeout": 300000,
      "cwd": "${workspaceFolder}/apps/desktop",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Debug Renderer Process",
      "type": "chrome",
      "request": "attach",
      "address": "localhost",
      "port": 9222,
      "webRoot": "${workspaceFolder}/apps/web",
      "sourceMaps": true,
      "restart": true,
      "timeout": 300000
    }
  ]
}
