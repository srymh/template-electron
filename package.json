{
  "name": "your-app-name-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @your-app-name/web --filter your-app-name run dev",
    "build": "pnpm --filter @your-app-name/web run build && pnpm --filter your-app-name run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm run typecheck && oxlint",
    "format": "oxfmt",
    "check": "pnpm run typecheck && oxlint --fix && oxfmt"
  },
  "devDependencies": {
    "@typescript/native-preview": "7.0.0-dev.20260508.1",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  }
}
