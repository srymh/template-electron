{
  "name": "@repo/ai-tools",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./server/*": {
      "types": "./src/server/*.ts",
      "import": "./src/server/*.ts"
    },
    "./client/*": {
      "types": "./src/client/*.ts",
      "import": "./src/client/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@repo/rag": "workspace:*",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/ai": "^0.14.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsdown": "^0.21.10"
  },
  "peerDependencies": {
    "electron": "^41.2.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  }
}
