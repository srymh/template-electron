{
  "name": "@repo/shadcn",
  "version": "4.6.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/*": "./src/lib/*.ts",
    "#icons/*": "./src/icons/*.tsx",
    "#design-system/*": "./src/design-system/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ui/*": {
      "types": "./src/components/ui/*.tsx",
      "import": "./src/components/ui/*.tsx"
    },
    "./hooks/*": {
      "types": "./src/hooks/*.ts",
      "import": "./src/hooks/*.ts"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "import": "./src/lib/*.ts"
    },
    "./styles.css": {
      "style": "./src/styles.css",
      "import": "./src/styles.css"
    },
    "./themes": {
      "style": "./src/themes.ts",
      "import": "./src/themes.ts"
    },
    "./design-system": {
      "types": "./src/design-system/index.ts",
      "import": "./src/design-system/index.ts"
    },
    "./demo/*": {
      "types": "./src/demo/components/*.tsx",
      "import": "./src/demo/components/*.tsx"
    },
    "./demo/constants": {
      "types": "./src/demo/constants.ts",
      "import": "./src/demo/constants.ts"
    },
    "./demo/registry": {
      "types": "./src/demo/registry.ts",
      "import": "./src/demo/registry.ts"
    }
  },
  "scripts": {
    "lint": "tsgo"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@hugeicons/core-free-icons": "^1.2.1",
    "@hugeicons/react": "^1.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@remixicon/react": "^4.7.0",
    "@tabler/icons-react": "^3.31.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.544.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.6.4",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260421.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.10"
  },
  "packageManager": "pnpm@10.33.0"
}
